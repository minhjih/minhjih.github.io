# 이 파일을 .env로 복사하고 값을 채우세요.  (.env는 절대 커밋 금지 — .gitignore에 등록됨)
#   cp .env.example .env
#
# 앱키 발급: https://apiportal.koreainvestment.com
#   - 실전투자 앱키/시크릿: 시세 조회용 (모의투자 모드여도 필요)
#   - 모의투자 앱키/시크릿: 주문용

KIS_ID=your_hts_id                  # 한국투자증권 HTS 로그인 ID
KIS_ACCOUNT=12345678-01             # 모의투자 계좌번호
KIS_APPKEY=                         # 실전 앱키
KIS_SECRETKEY=                      # 실전 시크릿
KIS_VIRTUAL_APPKEY=                 # 모의투자 앱키
KIS_VIRTUAL_SECRETKEY=              # 모의투자 시크릿

# ── 가드레일 (코드 레벨 강제) ──
MAX_ORDER_KRW=500000                # 1회 주문 금액 상한 (원)
MAX_QTY_PER_ORDER=10                # 1회 주문 수량 상한
MAX_ORDERS_PER_DAY=10               # 일일 주문 횟수 상한
SYMBOL_WHITELIST=005930,000660,069500   # 주문 허용 종목 (비우면 전 종목 허용)

# ── 루프 설정 ──
# CYCLE_INTERVAL_SEC=900            # 사이클 주기 (초)
# GEMINI_MODEL=gemini-2.5-flash     # run_cycle.sh가 쓰는 모델
